module radio-bridge-tg-radio-dn {

    yang-version "1.1";

    // namespace
    namespace "http://siklu.com/yang/tg/radio/dn";

    prefix rb-tg-radio-dn;
    import ietf-yang-smiv2 {
        prefix "smiv2";
    }

    import radio-bridge-tg-radio-common {
        prefix "rb-tg-radio";
    }
    import radio-bridge-tg-types {
        prefix "rb-tg-types";
    }
    import radio-bridge-tg-gui {
        prefix "rb-tg-gui";
    }
    import clixon-autocli {
        prefix autocli;
    }
    import clixon-snmp {
        prefix "cx-snmp";
    }

    // meta
    organization
      "Siklu";

    contact
      "Support: <https://siklu.com/contact/>";

    description
      "This YANG module is part of radio-bridge TG project.
        It defines the dn radio part of the project";

    revision 2025-10-28 {
        description
          "Add new dn-link-state enums - LocalSectorFull & ControlSuperFrameUsed";
        reference
          "";
    }

    revision 2025-09-28 {
        description
          "Add new dn-link-state enum - FoundInScanButSsidNotMatching";
        reference
          "";
    }

    revision 2025-09-21 {
