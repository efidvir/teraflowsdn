    }

    revision 2023-11-06 {
        description
          "set default no-sync to sync-mode";
        reference
          "";
    }

    revision 2023-10-24 {
        description
          "update link ignition configuration";
        reference
          "";
    }

    revision 2023-10-23 {
        description
          "add link ignition configuration";
        reference
          "";
    }

    revision 2023-08-22 {
        description
          "add sector-index leaf to rf-sync-clocks-state clocks list";
        reference
          "";
    }

    revision 2023-08-20 {
